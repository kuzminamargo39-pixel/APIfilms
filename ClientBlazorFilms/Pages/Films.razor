@page "/films"
@using ClientBlazorFilms.ViewModels
@using ClientBlazorFilms.Models.DTO
@inject FilmsViewModel ViewModel
@inject ClientBlazorFilms.Services.IFilmService FilmService

<PageTitle>Catalogue des Films</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">🎬 Catalogue des Films</h2>
        <small class="text-muted">Explorez et gérez vos œuvres favorites</small>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-success" @onclick="ToggleAddModal">
            ➕ Ajouter un film
        </button>
        <span class="badge bg-primary fs-6 d-flex align-items-center">
            Total : @ViewModel.FilteredFilms.Count()
        </span>
    </div>
</div>

@if (showAddForm)
{
    <div class="card p-3 mb-4 shadow border-success">
        <h5 class="text-success mb-3">Nouveau Film</h5>
        <div class="row g-2">
            <div class="col-md-4">
                <input type="text" class="form-control" placeholder="Titre..." @bind="newFilm.Titre" />
            </div>
            <div class="col-md-4">
                <input type="text" class="form-control" placeholder="Genre (ex: Sci-Fi, Drame)..." @bind="newFilm.Genre" />
            </div>
            <div class="col-md-2">
                <input type="number" class="form-control" placeholder="Durée (min)" @bind="newFilm.Duree" />
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button class="btn btn-success w-100" @onclick="CreateFilm">Enregistrer</button>
                <button class="btn btn-outline-secondary" @onclick="ToggleAddModal">✕</button>
            </div>
        </div>
        <div class="mt-2">
            <textarea class="form-control" placeholder="Résumé / Description..." rows="2" @bind="newFilm.Resume"></textarea>
        </div>
    </div>
}

<div class="card p-3 shadow-sm mb-4 bg-white">
    <div class="row g-3 align-items-center">
        <div class="col-md-6 d-flex gap-2">
            <button class="btn btn-primary"
                    disabled="@ViewModel.LoadFilmsCommand.IsRunning"
                    @onclick="ReloadFast">
                🔄 Recharger
            </button>

            <button class="btn btn-outline-secondary"
                    disabled="@ViewModel.LoadFilmsCommand.IsRunning"
                    @onclick="ReloadSlow">
                ⏳ Réseau lent (4s)
            </button>

            <button class="btn btn-danger"
                    hidden="@(!ViewModel.LoadFilmsCommand.CanBeCanceled)"
                    @onclick="() => ViewModel.LoadFilmsCommand.Cancel()">
                ⛔ Annuler
            </button>
        </div>

        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text">🔍</span>
                <input type="text" class="form-control" placeholder="Filtrer par titre ou genre..."
                       @bind="ViewModel.SearchTerm" @bind:event="oninput" />
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(ViewModel.Message))
{
    <div class="alert alert-info shadow-sm">@ViewModel.Message</div>
}

@if (ViewModel.LoadFilmsCommand.IsRunning)
{
    <div class="text-center my-5">
        <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status"></div>
        <p class="mt-2 text-muted">Récupération des films en cours...</p>
    </div>
}
else if (!ViewModel.FilteredFilms.Any())
{
    <div class="alert alert-warning text-center">
        Aucun film trouvé dans la base de données.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var film in ViewModel.FilteredFilms)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 bg-light">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title text-primary mb-0">@film.Titre</h5>
                            <span class="badge bg-secondary">@(film.AnneeSortie?.ToString() ?? "N/A")</span>
                        </div>
                        <p class="card-text text-muted mb-4">
                            <span class="badge bg-info text-dark">@film.Genre</span>
                        </p>
                        <div class="mt-auto d-flex justify-content-end">
                            <a class="btn btn-sm btn-outline-primary" href="films/@film.Id">
                                ✏️ Détails / Éditer
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private bool showAddForm = false;
    private FilmDetailDto newFilm = new() { DateSortie = DateTime.UtcNow, Duree = 120 };

    protected override async Task OnInitializedAsync()
    {
        await ReloadFast();
    }

    private async Task ReloadFast()
    {
        await ViewModel.LoadFilmsCommand.ExecuteAsync(TimeSpan.Zero);
    }

    private async Task ReloadSlow()
    {
        await ViewModel.LoadFilmsCommand.ExecuteAsync(TimeSpan.FromSeconds(4));
    }

    private void ToggleAddModal()
    {
        showAddForm = !showAddForm;
        if (showAddForm)
        {
            newFilm = new FilmDetailDto { DateSortie = DateTime.UtcNow, Duree = 120 };
        }
    }

    private async Task CreateFilm()
    {
        if (string.IsNullOrWhiteSpace(newFilm.Titre)) return;

        bool success = await FilmService.CreateFilmAsync(newFilm);
        if (success)
        {
            showAddForm = false;
            await ReloadFast();
        }
    }
}