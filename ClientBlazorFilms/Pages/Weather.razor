@page "/weather"
@inject HttpClient Http

<PageTitle>Météo en direct</PageTitle>

<h2>🌦️ Prévisions Météorologiques</h2>
<p class="text-muted">Données synchronisées directement depuis le contrôleur ASP.NET Core API.</p>

@if (forecasts == null)
{
    <div class="d-flex align-items-center gap-2 my-4">
        <div class="spinner-border text-primary" role="status"></div>
        <span>Récupération des prévisions depuis le serveur...</span>
    </div>
}
else
{
    <table class="table table-hover align-middle shadow-sm bg-white rounded mt-3">
        <thead class="table-primary">
            <tr>
                <th>Date</th>
                <th>Temp. (°C)</th>
                <th>Temp. (°F)</th>
                <th>Condition</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var forecast in forecasts)
            {
                <tr>
                    <td>@forecast.Date.ToShortDateString()</td>
                    <td><span class="badge @(forecast.TemperatureC > 15 ? "bg-warning text-dark" : "bg-info")">@forecast.TemperatureC °C</span></td>
                    <td>@forecast.TemperatureF °F</td>
                    <td>@forecast.Summary</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private WeatherForecast[]? forecasts;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            forecasts = await Http.GetFromJsonAsync<WeatherForecast[]>("WeatherForecast");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur météo: {ex.Message}");
        }
    }

    public class WeatherForecast
    {
        public DateOnly Date { get; set; }
        public int TemperatureC { get; set; }
        public string? Summary { get; set; }
        public int TemperatureF => 32 + (int)(TemperatureC / 0.5556);
    }
}